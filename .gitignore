# Local .terraform directories
**/.terraform/*

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

local-tests/
*.zip
examples/local
**.terraform
**.terraform.lock.hcl

# Exclude all .tfvars files, which are likely to contain sensitive data, such as
# password, private keys, and other secrets. These should not be part of version
# control as they are data points which are potentially sensitive and subject
# to change depending on the environment.
*.tfvars
*.tfvars.json

# Ignore override files as they are usually used to override resources locally and so
# are not checked in
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Include override files you do wish to add to version control using negated pattern
# !example_override.tf

# Include tfplan files to ignore the plan output of command: terraform plan -out=tfplan
# example: *tfplan*

# Ignore CLI configuration files
.terraformrc
terraform.rc

# Local test harnesses and credentials — never commit. Stream Security provider
# credentials belong in the environment (STREAMSEC_HOST / STREAMSEC_WORKSPACE_ID
# / STREAMSEC_API_TOKEN), never in a file. `local-tests/` is already covered
# above; `*.env` covers `.env` too.
*.env
env.sh
# Plan files hold the collection token in plaintext. `tfplan` with no extension
# is the name the usage docs tell people to type, and it matched none of the
# patterns below.
# archive_file writes the Lambda zip into the module directory, and Python leaves
# __pycache__ next to the source. A .pyc was committed on this branch before
# these were added.
__pycache__/
*.py[cod]
modules/*/lambda/*.zip

tfplan
tfplan.*
*.tfplan
*.tfplan.*
scanner-test/

# The unknown-value harness is a real root module; ignore its local state.
modules/*/tests/unknown-values/.terraform/
modules/*/tests/unknown-values/.terraform.lock.hcl
